# v2 (see docs/architecture.md). Generate the key with: jobhunt keygen
JOBHUNT_SECRET_KEY=
# Postgres (Supabase pooler URL). Leave empty to use local SQLite.
DATABASE_URL=
# Operator-only channel for the heartbeat. Never a subscriber webhook.
ADMIN_WEBHOOK_URL=
# Only for the legacy resume tailor command.
ANTHROPIC_API_KEY=
# Web app (Vercel). DATABASE_URL must be the Supabase *transaction pooler* URL (port 6543).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Public origin used in the manage links posted to Discord (no trailing slash).
PUBLIC_BASE_URL=https://your-project.vercel.app
