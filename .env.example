# jobhunt v2. Copy to .env (chmod 600). Never commit .env.
# Generate once with `jobhunt keygen`. Same value on Vercel and the worker.
JOBHUNT_SECRET_KEY=
# Postgres. Leave empty locally to use SQLite (jobhunt_v2.db).
#   Vercel (web):  Supabase transaction pooler URL, port 6543
#   Worker (VM):   Supabase session pooler URL, port 5432 (IPv4)
# postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:PORT/postgres
DATABASE_URL=
# Worker only: private operator channel for the daily heartbeat. Never a subscriber webhook.
ADMIN_WEBHOOK_URL=
# Web only: public origin used in the manage links posted to Discord (no trailing slash).
PUBLIC_BASE_URL=
# Web only (Vercel, mark as Secret type): bearer token for POST /ingest/posting (external pipeline).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"   (must be >= 32 chars)
INGEST_SECRET=
# Web only: the ingest route answers 503 unless this is exactly "true". Set anything else = kill switch.
INGEST_ENABLED=
# Optional: contact address sent in the scraper User-Agent.
JOBHUNT_CONTACT=
# Legacy `jobhunt tailor` command only.
ANTHROPIC_API_KEY=
